/* 
  Program ini digunakan untuk menghitung nilai f(n) menggunakan metode rekrusif.
  Pola persamaan :
  f(5) = 5 * (4/2) * 3 * (2/2) * 1
  f(7) = 7 * (6/2) * 5 * (4/2) * 3 * (2/2) * 1

    Cara Kerja :
1. Jika n = 1, fungsi mengembalikan nilai 1 (base case)
2. Jika n > 1, fungsi mengalikan n dengan hasil rekrusif dari (n-1)
3. Setiap bilangan genap, dibagi 2 sebelum dikalikan
4. Proses berulang sampai mencapai base case
*/


#include <iostream> 
using namespace std;

//Fungsi Rekrusif
int hitung(int n){
    if (n == 1){
        return 1;
    }
    if (n%2 == 0){
        return (n/2)*hitung(n-1);
    }
    return n*hitung(n-1);
}

int main(){
cout << "f(5)="<<hitung(5)<<endl;
cout << "f(7)="<<hitung(7)<<endl;

    return 0;
}
  
